---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
---

<Layout title="Tous les Guides & Articles Menuiserie — Paris Fenêtres">
  <section class="border-b border-stone-800 bg-stone-950 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="inline-flex items-center gap-2 rounded-full border border-amber-500/30 bg-amber-950/30 px-3 py-1 text-xs text-amber-300 mb-4">
        CATALOGUE DES PUBLICATIONS
      </div>
      <h1 class="font-serif text-3xl font-extrabold text-stone-100 sm:text-4xl">Tous les Articles & Guides de Menuiserie</h1>
      <p class="mt-3 max-w-2xl text-stone-400 text-sm">
        Explorez nos 200 fiches pratiques, études acoustiques et guides de rénovation de fenêtres à Paris.
      </p>
    </div>
  </section>

  <section class="py-12 bg-stone-950">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedPosts.map(post => (
          <article class="flex flex-col justify-between rounded-xl border border-stone-800 bg-stone-900/50 p-6 hover:border-amber-500/50 transition-colors">
            <div>
              <div class="flex items-center justify-between text-[11px] text-stone-400 mb-3">
                <span class="rounded bg-stone-800 px-2 py-0.5 text-amber-400 font-medium">{post.data.category || 'Article'}</span>
                <span>{new Date(post.data.pubDate).toLocaleDateString('fr-FR', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
              </div>
              <h2 class="font-serif text-lg font-bold text-stone-100 hover:text-amber-400 transition-colors line-clamp-2">
                <a href={'/blog/' + post.id + '/'}>{post.data.title}</a>
              </h2>
              <p class="mt-2 text-xs text-stone-400 line-clamp-3 leading-relaxed">
                {post.data.description}
              </p>
            </div>
            <div class="mt-5 pt-4 border-t border-stone-800 flex justify-end text-xs">
              <a href={'/blog/' + post.id + '/'} class="text-amber-400 hover:underline">
                Lire le guide →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
