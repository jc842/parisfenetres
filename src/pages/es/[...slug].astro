---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog-es');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title + ' — Paris Fenêtres'} description={post.data.description} lang="es">
  <article class="py-12 bg-stone-950">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <div class="flex items-center gap-2 text-xs text-stone-400 mb-6">
        <a href="/es/" class="hover:text-amber-400">Edición en Español</a>
        <span>/</span>
        <span class="text-amber-400">{post.data.category}</span>
      </div>
      <header class="border-b border-stone-800 pb-8 mb-8">
        <h1 class="font-serif text-2xl sm:text-4xl font-extrabold text-stone-100 tracking-tight leading-tight">
          {post.data.title}
        </h1>
        <p class="mt-3 text-xs text-stone-400">Paris Fenêtres — Documentación Técnica</p>
      </header>
      <div class="prose prose-invert prose-stone max-w-none prose-headings:font-serif prose-headings:text-stone-100 prose-a:text-amber-400 leading-relaxed text-stone-300">
        <Content />
      </div>
      <footer class="mt-12 border-t border-stone-800 pt-8 text-xs text-stone-400">
        <a href="/es/" class="text-amber-400 hover:underline">← Volver a las guías en español</a>
      </footer>
    </div>
  </article>
</Layout>
